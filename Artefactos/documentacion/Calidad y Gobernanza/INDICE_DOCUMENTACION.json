      "feature_flags": [],
      "estados": ["loading", "empty", "success", "error"]
    },
    "BP-06_PRESUPUESTOS": {
      "blueprint": { "fuente": "blueprints_md", "seccion": "BP-06" },
      "flujos": { "fuente": "flujos_md", "seccion": "F4" },
      "historias": ["HU-11", "HU-12"],
      "componentes_ds": [".progress", ".chip", ".money-input", ".btn primary", ".toast warn", ".empty"],
      "entidades_contratos": ["budgets upsert", "evaluateBudgets()", "budget:exceeded", "categories"],
      "reglas": ["calidad_a11y#contraste-no-solo-color"],
      "feature_flags": [],
      "estados": ["loading", "empty", "success", "error"]
    },
    "BP-07_REPORTES": {
      "blueprint": { "fuente": "blueprints_md", "seccion": "BP-07" },
      "historias": ["HU-13"],
      "componentes_ds": [".segmented", ".tx", ".chip", ".empty", ".btn secondary", ".spinner"],
      "entidades_contratos": ["computeMonthReport()", "byCategory[]"],
      "reglas": ["calidad_a11y#graficos-aria-label", "calidad_pruebas#cobertura-negocio"],
      "feature_flags": ["feature.reportes.v1"],
      "estados": ["loading", "empty", "success", "error"]
    },
    "BP-08_AJUSTES_RAIZ": {
      "blueprint": { "fuente": "blueprints_md", "seccion": "BP-08" },
