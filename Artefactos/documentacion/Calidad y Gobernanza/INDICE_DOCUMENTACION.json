      "reglas": ["calidad_i18n#montos", "calidad_a11y#targets-44"],
      "feature_flags": [],
      "estados": ["loading", "empty", "success", "error"]
    },
    "BP-09_EXPORTAR_BOVEDA": {
      "blueprint": { "fuente": "blueprints_md", "seccion": "BP-09" },
      "flujos": { "fuente": "flujos_md", "seccion": "F5" },
      "historias": ["HU-14"],
      "componentes_ds": [".btn primary", ".modal", ".progress", ".toast", ".chip", ".input"],
      "entidades_contratos": ["ExportPort.exportFile()", "MonederoFile v1", "integrity.sha256", "EXPORT_FAILED"],
      "reglas": ["calidad_observabilidad#cero-pii", "calidad_pruebas#matrix-fixtures"],
      "feature_flags": [],
      "estados": ["loading", "empty", "success", "error"]
    },
    "BP-10_IMPORTAR_BOVEDA": {
      "blueprint": { "fuente": "blueprints_md", "seccion": "BP-10" },
      "flujos": { "fuente": "flujos_md", "seccion": "F5" },
      "historias": ["HU-15", "HU-16"],
      "componentes_ds": [".segmented", ".modal", ".progress", ".toast", ".btn primary", ".fhint error"],
      "entidades_contratos": ["ExportPort.importFile()", "MonederoFileSchema", "ImportSummary", "IMPORT_*"],
      "reglas": ["calidad_pruebas#matrix-fixtures", "calidad_a11y#dialog"],
      "feature_flags": ["feature.import_replace.v1"],
      "estados": ["loading", "empty", "success", "error"]
    },
    "FLUJO_F6_BORRADO_TOTAL": {
      "flujos": { "fuente": "flujos_md", "seccion": "F6" },
      "historias": ["HU-19"],
      "componentes_ds": [".btn ghost", ".input", ".modal"],
      "entidades_contratos": ["wipe", "onboarding HU-01"],
      "reglas": ["calidad_a11y#dialog", "calidad_pruebas#cobertura-critica"],
      "feature_flags": ["ops.wipe_double_confirm"],
      "estados": ["empty", "success", "error"]
    }
  },
  "gates_ci_globales": {
    "typecheck": "tsc --noEmit en todos los paquetes",
    "lint": "ESLint + reglas i18n/flags/naming + sin console.* en producto",
    "test": "unit + integration + coverage>=80% negocio",
    "a11y": "axe-core PWA + jest-axe + props RN",
    "tokens": "tokens:check — solo colores --cs-* en UI",
    "contract": "contract:check — fixtures .monedero válidas en ambas apps",
    "network": "no-network — falla si hay fetch externo en prod"
  }
}
