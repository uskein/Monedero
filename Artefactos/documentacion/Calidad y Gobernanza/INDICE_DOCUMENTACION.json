      "reglas": ["calidad_a11y#contraste-no-solo-color", "calidad_a11y#reduced-motion", "calidad_i18n#montos"],
      "feature_flags": ["experiment.balance_compact"],
      "estados": ["loading", "empty", "success", "error"]
