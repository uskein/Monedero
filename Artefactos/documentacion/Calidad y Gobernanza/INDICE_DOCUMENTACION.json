      "blueprint": { "fuente": "blueprints_md", "seccion": "BP-01" },
      "flujos": { "fuente": "flujos_md", "seccion": "F1" },
      "historias": ["HU-01", "HU-02", "HU-18"],
      "componentes_ds": [".input", ".btn primary", ".progress", ".fhint error", ".modal", ".toggle"],
      "entidades_contratos": ["settings['vault']", "KeyVaultPort", "PBKDF2>=120k", "VALIDATION_FAILED", "settings['currency']"],
      "reglas": ["calidad_a11y#formulario", "calidad_i18n#formularios", "calidad_observabilidad#log-errores"],
      "feature_flags": ["env.debug_menu"],
      "estados": ["loading", "empty", "success", "error"]
    },
    "BP-02_VAULTGATE_BLOQUEO": {
      "blueprint": { "fuente": "blueprints_md", "seccion": "BP-02" },
      "flujos": { "fuente": "flujos_md", "seccion": "F2" },
      "historias": ["HU-03", "HU-04"],
      "componentes_ds": [".btn primary", ".input", ".spinner", ".fhint error"],
      "entidades_contratos": ["vault:locked", "vault:unlocked", "KeyVaultPort.unlock()", "VAULT_LOCKED"],
      "reglas": ["calidad_a11y#dialog", "calidad_observabilidad#cero-pii"],
      "feature_flags": [],
      "estados": ["loading", "empty", "success", "error"]
    },
