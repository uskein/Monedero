{
  "$schema": "internal://monedero/doc-index",
  "version": 1,
  "descripcion": "Índice de contexto dinámico para el Orquestador (Skill 4). Regla de inyección: por tarea cargar SOLO los chunks listados aquí, nunca la documentación completa. Objetivo: precisión y ahorro de ventana de contexto.",
  "regla_oro": "1 pantalla (blueprint) + sus componentes DS + su contrato/entidad + reglas a11y/i18n aplicables. Nada más.",
  "fuentes_base": {
    "ssot_visual": "Artefactos/documentacion/Diseño Visual/manual-identidad-visual.md",
    "arquitectura": "Artefactos/documentacion/Arquitectura/README_ARQUITECTURA.md",
    "modelo_datos": "Artefactos/documentacion/Arquitectura/MODELO_DE_DATOS.md",
    "contratos": "Artefactos/documentacion/Arquitectura/CONTRATOS_API.md",
    "requerimientos": "Artefactos/documentacion/Producto y Flujos/REQUERIMIENTOS_FUNCIONALES.md",
    "arquitectura_informacion": "Artefactos/documentacion/Producto y Flujos/ARQUITECTURA_INFORMACION.md",
    "blueprints_md": "Artefactos/documentacion/Producto y Flujos/BLUEPRINTS_DE_PANTALLAS.md",
    "flujos_md": "Artefactos/documentacion/Producto y Flujos/FLUJOS_DE_USUARIO.md",
    "calidad_pruebas": "Artefactos/documentacion/Calidad y Gobernanza/ESTRATEGIA_PRUEBAS.md",
    "calidad_a11y": "Artefactos/documentacion/Calidad y Gobernanza/ESTANDAR_ACCESIBILIDAD.md",
    "calidad_i18n": "Artefactos/documentacion/Calidad y Gobernanza/ESTANDAR_INTERNACIONALIZACION.md",
    "calidad_observabilidad": "Artefactos/documentacion/Calidad y Gobernanza/ESTRATEGIA_OBSERVABILIDAD.md",
    "calidad_flags": "Artefactos/documentacion/Calidad y Gobernanza/ESTRATEGIA_FEATURE_FLAGS.md"
  },
  "tareas": {
