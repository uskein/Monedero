# Monedero móvil — variables de entorno (SIN SECRETOS: app 100% local)
# Prefijo obligatorio EXPO_PUBLIC_* (ESTRUCTURA_DIRECTORIOS §3)
EXPO_PUBLIC_APP_SCHEME=monedero
# EAS_PROJECT_ID=  # se rellena al crear el proyecto en EAS (S8 release)
# Feature flags build-time (ESTRATEGIA_FEATURE_FLAGS.md §1)
EXPO_PUBLIC_FLAG_ENV_DEBUG_MENU=false
