{
  "name": "@monedero/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Esquema SQLite + migraciones numeradas (user_version) compartidas por semanticas entre móvil (SQLCipher) y PWA (sql.js). DDL SSOT: MODELO_DE_DATOS.md.",
  "main": "src/index.ts",
  "types": "src/index.ts",
