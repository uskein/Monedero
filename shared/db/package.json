  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/sql.js": "^1.4.11",
    "sql.js": "^1.14.2",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0",
    "@vitest/coverage-v8": "3.2.7"
  }
}
